# 복사해서 .env 로 저장 후 값 수정
# 주의: 주석은 반드시 별도 줄에 쓰세요. "KEY=  # 설명" 처럼 쓰면 Docker 가 설명을 값으로 읽습니다.

SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://localhost:8000
# DATABASE_URL=postgresql://user:pass@localhost/bestkorea
# (Docker 에서는 docker-compose.yml 이 DB 주소를 넣어주므로 비워 두세요. 기본: instance/bestkorea.db SQLite)

# HTTPS 로 운영할 때만 true (로컬 http 에서 true 면 로그인이 안 될 수 있음)
SESSION_COOKIE_SECURE=false
# nginx 등 HTTPS 프록시 뒤에서 실행할 때 true
BEHIND_PROXY=false
# 이 이메일로 가입한 회원이 관리자(1명)가 됨. 비우면 첫 가입자
ADMIN_EMAIL=

# Google AdSense (승인 후 입력)
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_IN_ARTICLE=
ADSENSE_SLOT_IN_FEED=
SHOW_AD_PLACEHOLDERS=true
GOOGLE_ANALYTICS_ID=

# 자동 수집: 사이트에 바로 게시되지 않고 관리자·운영자 전용 '수집함'에 쌓임
# 최근 24시간 게시물 중 댓글 많은 글을 사이트별로 하루(한국 시간) PER_SITE_DAILY 개씩
# 단일 프로세스(flask run)면 true, Docker/gunicorn 은 false (수집기 컨테이너가 담당)
ENABLE_SCHEDULER=false
COLLECT_INTERVAL_MINUTES=180
# 필수: YouTube Data API v3 키 (Google Cloud 콘솔에서 무료 발급). 비우면 수집되는 글이 없음
YOUTUBE_API_KEY=
# 선택: X(트위터) API v2 Bearer 토큰 (developer.x.com, 게시물 검색이 되는 유료 요금제 필요)
# 비우면 X 는 수집하지 않음. 읽은 게시물 수만큼 월 사용량이 차감되므로 아래 값으로 조절
X_BEARER_TOKEN=
# X 검색 최소 간격(시간)
X_INTERVAL_HOURS=6
# 검색 1회에 읽을 게시물 수 (10~100)
X_SEARCH_MAX_RESULTS=50
# 게시물당 읽을 답글 수 (10~100)
X_REPLIES_PER_ITEM=20
# 댓글이 이 개수 이상인 글만 수집
MIN_COMMENTS=10
# 사이트별 하루 수집 개수
PER_SITE_DAILY=10
# 글당 저장·번역할 댓글 수 (인기순, YouTube 는 최대 100)
COMMENTS_PER_ITEM=50

# 수집함 '번역' 버튼: 원문 본문 전체 + 댓글 전체 번역 (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# 번역할 본문 최대 글자 수 (아주 긴 기사는 앞부분만 번역)
ARTICLE_MAX_CHARS=60000
