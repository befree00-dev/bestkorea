# 복사해서 .env 로 저장 후 값 수정
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=https://bestkorea.example.com
# DATABASE_URL=postgresql://user:pass@localhost/bestkorea   (기본: instance/bestkorea.db SQLite)
SESSION_COOKIE_SECURE=true
BEHIND_PROXY=true             # nginx/Render 등 HTTPS 프록시 뒤에서 실행할 때
ADMIN_EMAIL=                  # 이 이메일로 가입하면 관리자 (비우면 첫 가입자)

# Google AdSense (승인 후 입력)
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_IN_ARTICLE=
ADSENSE_SLOT_IN_FEED=
SHOW_AD_PLACEHOLDERS=false
GOOGLE_ANALYTICS_ID=

# 자동 수집
ENABLE_SCHEDULER=false        # 단일 프로세스면 true, gunicorn 다중 워커면 false + cron
COLLECT_INTERVAL_MINUTES=180
COLLECT_MAX_PER_SOURCE=4
COLLECT_MAX_PER_RUN=40
DAILY_TARGET=10
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 선택: Claude로 한국어 번역/요약/분류
TRANSLATE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
