# 복사해서 .env 로 저장 후 값 수정
# 주의: 주석은 반드시 별도 줄에 쓰세요. "KEY=  # 설명" 처럼 쓰면 Docker 가 설명을 값으로 읽습니다.

SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://localhost:8000
# DATABASE_URL=postgresql://user:pass@localhost/bestkorea
# (Docker 에서는 docker-compose.yml 이 DB 주소를 넣어주므로 비워 두세요. 기본: instance/bestkorea.db SQLite)

# HTTPS 로 운영할 때만 true (로컬 http 에서 true 면 로그인이 안 될 수 있음)
SESSION_COOKIE_SECURE=false
# nginx 등 HTTPS 프록시 뒤에서 실행할 때 true
BEHIND_PROXY=false
# 이 이메일로 가입한 회원이 관리자(1명)가 됨. 비우면 첫 가입자
ADMIN_EMAIL=

# Google AdSense (승인 후 입력)
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_IN_ARTICLE=
ADSENSE_SLOT_IN_FEED=
SHOW_AD_PLACEHOLDERS=true
GOOGLE_ANALYTICS_ID=

# 자동 수집: 사이트에 바로 게시되지 않고 관리자·운영자 전용 '수집함'에 쌓임
# 단일 프로세스(flask run)면 true, Docker/gunicorn 은 false (수집기 컨테이너가 담당)
ENABLE_SCHEDULER=false
COLLECT_INTERVAL_MINUTES=180
COLLECT_MAX_PER_SOURCE=4
COLLECT_MAX_PER_RUN=40
DAILY_TARGET=10
# 커뮤니티(Reddit) 글은 댓글이 이 개수 이상일 때만 수집
MIN_COMMENTS=10
# 글당 저장·번역할 댓글 수 (인기순)
COMMENTS_PER_ITEM=50
# 비우면 Reddit 수집 안 함 (키 없는 요청은 Reddit 이 차단)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 수집함 '번역' 버튼: 원문 기사 500자 이내 요약 + 댓글 전체 번역 (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
SUMMARY_MAX_CHARS=500
